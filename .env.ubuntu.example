# Copy this file to .env on the Ubuntu server, then fill in real values.
# Never commit the real .env file.

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=replace_with_real_value
LINE_CHANNEL_SECRET=replace_with_real_value

# LIFF
LIFF_ID=replace_with_real_value

# Supabase fallback / backup.
# Keep these values while PostgreSQL is still new, so rollback can be done by
# setting DB_BACKEND=supabase.
SUPABASE_URL=replace_with_real_value
SUPABASE_KEY=replace_with_real_value

# Database backend switch.
# Production on Ubuntu should use postgres after migration testing passes.
# Rollback option: set DB_BACKEND=supabase, then rebuild/restart main.
DB_BACKEND=postgres

# PostgreSQL on Ubuntu.
# These values are used only when starting docker-compose.postgres.yml and later
# when DB_BACKEND=postgres.
POSTGRES_DB=medication_vqa
POSTGRES_USER=medication_vqa
POSTGRES_PASSWORD=replace_with_a_strong_postgres_password
DATABASE_URL=postgresql://medication_vqa:replace_with_a_strong_postgres_password@db:5432/medication_vqa

# Gemini
GEMINI_API_KEY=replace_with_real_value

# Main app -> internal YOLO PDPA service
PDPA_MASKING_SERVICE_URL=http://pdpa-masker:17081/mask
PDPA_MASKING_SERVICE_TOKEN=replace_with_a_random_shared_token
LOCAL_PDPA_SERVICE_TOKEN=replace_with_the_same_random_shared_token
PDPA_MASKING_SERVICE_TIMEOUT_SECONDS=60

# YOLO OBB
YOLO_OBB_ENABLED=true
YOLO_OBB_MODEL_PATH=/app/models/yolo_obb/best_round3.pt
YOLO_OBB_CONFIDENCE=0.45
YOLO_OBB_IMAGE_SIZE=1024

# Temporary debug images for checking masked upload results.
# Production recommendation after testing is stable: set to false.
SAVE_LOCAL_PDPA_DEBUG_IMAGES=true
LOCAL_PDPA_DEBUG_DIR=/app/test/local_pdpa_debug
